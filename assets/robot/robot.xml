<mujoco model="estun_ier15_1430_mi">
  <option integrator="implicit"  iterations="100" timestep="0.001" solver="Newton" gravity="0 0 -9.81"/>

  <compiler angle="degree"  eulerseq="zyx" autolimits="true" balanceinertia="true"/>

  <default>
    <joint limited="true"    />
    <geom condim="4" contype="1" conaffinity="15" friction="0.9 0.2 0.2" solref="0.001 2" />
    <motor ctrllimited="true" />
    <equality solref="0.001 2" />
    <default class="visualgeom">
      <geom material="visualgeom" condim="1" contype="0" conaffinity="0" />
    </default>
    
    
    <default class="xarm7_hand">
      <geom type="mesh" material="black"/>
      <joint range="0 0.85" axis="1 0 0" armature="0.1" frictionloss="1"/>
      <site size="0.001" rgba="1 0 0 1" group="4"/>
      <general biastype="affine" forcerange="-100 100" ctrlrange="0 255" gainprm="0.333" biasprm="0 -100 -10"/>
      <default class="spring_link">
        <joint stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="driver">
        <joint armature="0.005" damping="0.1" solreflimit="0.005 1"/>
      </default>
      <default class="follower">
        <joint solreflimit="0.005 1"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
        <default class="pad_box1">
          <geom type="box" friction="0.7" solimp="0.95 0.99 0.001" solref="0.004 1" mass="0" priority="1" size="0.015 0.002 0.0095" rgba="0.0 0.1 0.7 1"/>
        </default>
        <default class="pad_box2">
          <geom type="box" friction="0.6" solimp="0.95 0.99 0.001" solref="0.004 1" mass="0" priority="1" size="0.015 0.002 0.0095" rgba="0.0 0.5 0.5 1"/>
        </default>
      </default>
    </default>
    
  </default>
  
    
  <asset>
    <!-- 1. 核心：在这里把手部模型作为一个外部资产引入，并给它起个别名 -->
    <model name="my_hand_component" file="hand.xml"/>
      <!-- 引入轴模型 -->
    <model name="peg_component" file="../peg/Peg34.9.xml"/>
    
    <mesh name="base_link" content_type="model/stl" file="iER15-1430-MI/visual/base_link.STL" />
    <mesh name="link1" content_type="model/stl" file="iER15-1430-MI/visual/link1.STL" />
    <mesh name="link2" content_type="model/stl" file="iER15-1430-MI/visual/link2.STL" />
    <mesh name="link3" content_type="model/stl" file="iER15-1430-MI/visual/link3.STL" />
    <mesh name="link4" content_type="model/stl" file="iER15-1430-MI/visual/link4.STL" />
    <mesh name="link5" content_type="model/stl" file="iER15-1430-MI/visual/link5.STL" />
    <mesh name="link6" content_type="model/stl" file="iER15-1430-MI/visual/link6.STL" />
    
    
    <mesh name="base_link_collision" content_type="model/stl" file="iER15-1430-MI/collision/base_link.STL" />
    <mesh name="link1_collision" content_type="model/stl" file="iER15-1430-MI/collision/link1.STL"/>
    <mesh name="link2_collision" content_type="model/stl" file="iER15-1430-MI/collision/link2.STL"/>      
    <mesh name="link3_collision" content_type="model/stl" file="iER15-1430-MI/collision/link3.STL"/>
    <mesh name="link4_collision" content_type="model/stl" file="iER15-1430-MI/collision/link4.STL"/>
    <mesh name="link5_collision" content_type="model/stl" file="iER15-1430-MI/collision/link5.STL"/>
    <mesh name="link6_collision" content_type="model/stl" file="iER15-1430-MI/collision/link6.STL"/>
                
    <texture name="texplane" type="2d" builtin="checker" rgb1=".0 .0 .0" rgb2=".6 .6 .6" width="100" height="100" />
    <material name="matplane" reflectance="0." texture="texplane" texrepeat="1 1" texuniform="true" />
    <material name="visualgeom" rgba="0.5 0.9 0.2 1" />
  </asset>


  
  
  <worldbody>
    <light directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false" />
    <light directional="true" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1" />
    <!--geom name="ground" type="plane" pos="0 0 0" size="100 100 0.001" quat="1 0 0 0" condim="3" conaffinity="15"/-->
    <camera name="fixed" pos="0 -3.0 0.5819121364240707" xyaxes="1 0 0 0 0 1" />
    <camera name="track" mode="trackcom" pos="0 -3.0 0.5819121364240707" xyaxes="1 0 0 0 0 1" />
    <body name="base" pos="0 0 0" quat="1 0 0 0">  
      <site name="imu" size="0.01" pos="0 0 0" />
      <geom type="mesh" rgba="0.95 0.95 0.95 1" mesh="base_link"  mass="45"  class="visualgeom" />
      <geom type="mesh" rgba="0.95 0.95 0.95 0" mesh="base_link_collision" contype="0" conaffinity="0"/>
      <body name="link_1" pos="0 0 0.58" gravcomp="1">

        <joint name="joint_1" pos="0 0 0" axis="0 0 -1" range="-180 180" actuatorfrcrange="-578 578" armature="3.5" frictionloss="26.8" damping="37.87"/>
        <geom type="mesh" rgba="0.95 0.95 0.95 1" mesh="link1" mass="44.11"   class="visualgeom" />
        <geom type="mesh" rgba="0.95 0.95 0.95 0" mesh="link1_collision" contype="1"/>
        <body name="link_2" gravcomp="1">

          <joint name="joint_2" pos="0 0 0" axis="0 1 0" range="-180 180" actuatorfrcrange="-937 937" armature="3" frictionloss="45.76" damping="83.68"/>
          <geom type="mesh" rgba="0.95 0.95 0.95 1" mesh="link2"  mass="27.69"  class="visualgeom" />
          <geom type="mesh" rgba="0.95 0.95 0.95 0" mesh="link2_collision" contype="1"/>
          <body name="link_3" pos="0 0 0.75" gravcomp="1">

            <joint name="joint_3" pos="0 0 0" axis="0 1 0" range="-270 90" actuatorfrcrange="-308 308" armature="2" frictionloss="28.19" damping="17.94"/>
            <geom type="mesh" rgba="0.95 0.95 0.95 1" mesh="link3"  mass="17.82" class="visualgeom" />
            <geom type="mesh" rgba="0.95 0.95 0.95 0" mesh="link3_collision" contype="1"/>
            <body name="link_4" pos="0 0.035 0" quat="0.707107 0 0.707107 0" gravcomp="1">

              <joint name="joint_4" pos="0 0 0" axis="0 0 -1" range="-180 180" actuatorfrcrange="-88 88" armature="0.5" frictionloss="10.81" damping="5.08"/>
              <geom type="mesh" rgba="0.95 0.95 0.95 1" mesh="link4"  mass="14.4"  class="visualgeom" />
              <geom type="mesh" rgba="0.95 0.95 0.95 0" mesh="link4_collision" contype="1" />
              <body name="link_5" pos="0 0 0.68" gravcomp="1">

                <joint name="joint_5" pos="0 0 0" axis="0 1 0" range="-180 180" actuatorfrcrange="-108 108" armature="0.5" frictionloss="16.4" damping="18.54"/>
                <geom type="mesh" rgba="0.95 0.95 0.95 1" mesh="link5" mass="5.19"  class="visualgeom" />
                <geom type="mesh" rgba="0.95 0.95 0.95 0" mesh="link5_collision" contype="1"/>
                <body name="link_6" gravcomp="1">

                  <joint name="joint_6" pos="0 0 0" axis="0 0 -1" range="-180 180" actuatorfrcrange="-62 62" armature="0.5" frictionloss="5.3" damping="3.97"/>
                  <geom type="mesh" rgba="0.95 0.95 0.95 1" mesh="link6" mass="3" class="visualgeom" />
                  <geom type="mesh" rgba="0.95 0.95 0.95 0" mesh="link6_collision" contype="1" />
                  
                  <site name="TCP_frame_SITE" pos="0 0 0.28" quat="1 0 0 0"/>   <!--0.13+0.15-->
                 
        	        <!-- 引入夹爪 -->
        	        <body name="hand_mount" pos="0 0 0.13" euler="0 0 0">
        	          <site name="ft_frame_SITE" pos="0 0 0.15" quat="1 0 0 0"/>   
    		            <attach model="my_hand_component" body="xarm_gripper_base_link" prefix="hand_" />
    		    
    		            <site name="ft_frame_SITE2" pos="0 0 0.15" quat="1 0 0 0"/> 
    		            <attach model="peg_component" body="root" prefix="peg_" />  
    		    
                    <!-- 轴前端面中心坐标系 -->
                    <site name="peg_tip_site"
                          pos="0.02 0.004625 0.238"
                           euler="0 0 0"/>
    		    
	                </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>



  <tendon>
    <fixed name="split">
      <joint joint="hand_right_driver_joint" coef="0.5"/>
      <joint joint="hand_left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>


<actuator>
    <!-- 加上 dyntype="filter" dynprm="0.02"，自动平滑点动阶跃指令 -->
    <!-- 优化后：降低阻尼 Kv (biasprm 第 3 项)，保留平滑滤波 dyntype="filter" -->
    <general name="joint_1" joint="joint_1" dyntype="filter" dynprm="0.02" ctrllimited="true" ctrlrange="-3.14159 3.14159" forcerange="-579 570" 
             gaintype="fixed" gainprm="30000" biastype="affine" biasprm="0 -30000 -2500" />
             
    <general name="joint_2" joint="joint_2" dyntype="filter" dynprm="0.02" ctrllimited="true" ctrlrange="-3.14159 3.14159" forcerange="-930 930" 
             gaintype="fixed" gainprm="50000" biastype="affine" biasprm="0 -50000 -3500" />
             
    <general name="joint_3" joint="joint_3" dyntype="filter" dynprm="0.02" ctrllimited="true" ctrlrange="-4.71 1.5723" forcerange="-300 300" 
             gaintype="fixed" gainprm="25000" biastype="affine" biasprm="0 -25000 -1800" />
             
    <general name="joint_4" joint="joint_4" dyntype="filter" dynprm="0.02" ctrllimited="true" ctrlrange="-3.14159 3.14159" forcerange="-85 85" 
             gaintype="fixed" gainprm="8000" biastype="affine" biasprm="0 -8000 -350" />
             
    <general name="joint_5" joint="joint_5" dyntype="filter" dynprm="0.02" ctrllimited="true" ctrlrange="-3.14159 3.14159" forcerange="-100 100" 
             gaintype="fixed" gainprm="8000" biastype="affine" biasprm="0 -8000 -300" />
             
    <general name="joint_6" joint="joint_6" dyntype="filter" dynprm="0.02" ctrllimited="true" ctrlrange="-3.14159 3.14159" forcerange="-60 60" 
             gaintype="fixed" gainprm="4000" biastype="affine" biasprm="0 -4000 -150" />
             
    <!-- 手爪驱动保持原样 -->
    <general class="xarm7_hand" name="fingers_actuator" tendon="split" 
             forcerange="-100 100" ctrlrange="0 255" ctrllimited="true" 
             biastype="affine" gainprm="0.333" biasprm="0 -100 -10"/>
  </actuator>
  

  <sensor>
  <!--
    <actuatorpos name="joint_1_p" actuator="joint_1" />
    <actuatorvel name="joint_1_v" actuator="joint_1" />
    <actuatorfrc name="joint_1_f" actuator="joint_1" noise="0.001" />
    <actuatorpos name="joint_2_p" actuator="joint_2" />
    <actuatorvel name="joint_2_v" actuator="joint_2" />
    <actuatorfrc name="joint_2_f" actuator="joint_2" noise="0.001" />
    <actuatorpos name="joint_3_p" actuator="joint_3" />
    <actuatorvel name="joint_3_v" actuator="joint_3" />
    <actuatorfrc name="joint_3_f" actuator="joint_3" noise="0.001" />
    <actuatorpos name="joint_4_p" actuator="joint_4" />
    <actuatorvel name="joint_4_v" actuator="joint_4" />
    <actuatorfrc name="joint_4_f" actuator="joint_4" noise="0.001" />
    <actuatorpos name="joint_5_p" actuator="joint_5" />
    <actuatorvel name="joint_5_v" actuator="joint_5" />
    <actuatorfrc name="joint_5_f" actuator="joint_5" noise="0.001" />
    <actuatorpos name="joint_6_p" actuator="joint_6" />
    <actuatorvel name="joint_6_v" actuator="joint_6" />
    <actuatorfrc name="joint_6_f" actuator="joint_6" noise="0.001" />
    <framequat name="orientation" objtype="site" noise="0.001" objname="imu" />
    <gyro name="angular-velocity" site="imu" noise="0.005" cutoff="34.9" />
     --> 
    
    <force name="ft_frame_SENSOR_FORCE" site="ft_frame_SITE"/>
    <torque name="ft_frame_SENSOR_TORQUE" site="ft_frame_SITE"/>
  </sensor>

  
</mujoco>
